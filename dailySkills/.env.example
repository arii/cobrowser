# Copy to .env and fill in. .env is gitignored. Variable names match the cobrowser repo's .env.example.

# Meta Llama API (OpenAI-compatible). Default endpoint is Meta's hosted Llama API; any
# OpenAI-compatible host serving a Llama model works (Together, Groq, Fireworks, local llama-server).
LLAMA_SCHEMA=openai-chat
LLAMA_ENDPOINT=https://api.llama.com/compat/v1/chat/completions
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
LLAMA_API_KEY=

# SubQ (Snap image/decision model + Preview chat model). https://docs.subq.ai
SUBQ_API_KEY=
SUBQ_SNAP_MODEL=subq-snap-1.1
SUBQ_CHAT_MODEL=subq-preview

# Google Gemini (vision + structured output), used by the target-labeling pass. Same names as the repo root .env.example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

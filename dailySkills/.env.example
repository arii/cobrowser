# Copy to .env and fill in. .env is gitignored. Variable names match the cobrowser repo's .env.example.

# Meta Model API (dev.meta.ai), OpenAI-compatible chat completions. Keys come from https://dev.meta.ai.
# muse-spark-1.3 reads images. Any other OpenAI-compatible host serving a Meta model also works here.
LLAMA_SCHEMA=openai-chat
LLAMA_ENDPOINT=https://api.meta.ai/v1/chat/completions
LLAMA_MODEL=muse-spark-1.3
LLAMA_API_KEY=

# SubQ (Snap image/decision model + Preview chat model). https://docs.subq.ai
SUBQ_API_KEY=
SUBQ_SNAP_MODEL=subq-snap-1.1
SUBQ_CHAT_MODEL=subq-preview



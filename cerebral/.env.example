# --- Subq (Decisions API): hot-path typed decisions. Semantic judge + repair-or-handoff choice.
# Without a key both fall back to deterministic policy.
SUBQ_API_KEY=
SUBQ_API_BASE=https://api.subq.ai/v1/systemone
SUBQ_MODEL=subq-snap-1.1

# --- Meta AI (Llama), OpenAI-compatible endpoint. Step naming, goal-check proposals, fallback judge.
META_API_KEY=
META_API_BASE=https://api.llama.com/compat/v1
META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# --- Browser worker. Stagehand's natural-language act() fallback is enabled only when a model key is set;
# otherwise the worker is pure Playwright (deterministic anchors only).
STAGEHAND_MODEL_API_KEY=
STAGEHAND_MODEL=openai/gpt-4.1-mini
HEADLESS=true

# --- Service URLs (Python API -> worker; worker -> API for recorded demo events; web -> both)
BROWSER_URL=http://localhost:8011
BROWSER_PORT=8011
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BROWSER_URL=http://localhost:8011
NEXT_PUBLIC_BROWSER_WS=ws://localhost:8011

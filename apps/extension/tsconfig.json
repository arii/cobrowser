{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [
      "chrome",
      "vite/client"
    ],
    "moduleDetection": "force"
  },
  "include": [
    "entrypoints/**/*",
    "wxt.config.ts"
  ]
}

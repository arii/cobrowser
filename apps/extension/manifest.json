{
  "manifest_version": 3,
  "name": "Harness Phase 0 probe",
  "version": "0.0.1",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "key": ""
}

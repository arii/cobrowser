# Export from a private shell/secret manager. Scripts do not load .env automatically.
HARNESS_CLOUD_ENABLED=0
LLAMA_SCHEMA=openai-chat
LLAMA_ENDPOINT=
LLAMA_MODEL=
LLAMA_API_KEY=
SUBQ_API_KEY=
# Phase 1 storage keys are never read from environment variables.
# The desktop companion wraps its artifact key with macOS Keychain-backed safeStorage.
# Offline tests and --smoke use ephemeral synthetic keys only.

# Rolling context engine: Snap handles images; Gemini Flash owns context for now.
CONTEXT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# After SubQ Preview approval, set CONTEXT_PROVIDER=subq to use the existing SUBQ_API_KEY.
